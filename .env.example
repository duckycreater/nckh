# =============================================================================
# BMO Robot — Environment Configuration Example
# =============================================================================
# Copy this file to `.env` (which is git-ignored) and fill in real values.
# NEVER commit the populated `.env` to version control.
#
# Grouped by service. Variables prefixed with `VITE_` are exposed to the
# client bundle (must be safe to ship to browsers). Everything else stays
# server-side only.
# =============================================================================

# ── Core / required ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Admin API key used for `x-admin-key` header on /api/admin/* routes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=replace-with-random-32-bytes-hex

# ── Supabase (research DB) ────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ-replace-with-service-role-key
# Public-safe (Vite exposed):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ-replace-with-anon-key

# ── Gemini (cloud vision) ────────────────────────────────────────────────────
GEMINI_API_KEY=AIza-replace-with-real-key

# ── Groq (fast LLM for chatbot) ──────────────────────────────────────────────
GROQ_API_KEY=gsk_replace-with-real-key

# ── Firebase Admin (auth + Firestore) ────────────────────────────────────────
# Either inline JSON …
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
# … or a path:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# ── Cloudinary (image uploads, dataset contribution) ──────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email (Resend: purchase alerts + password recovery) ──────────────────────
RESEND_API_KEY=re_replace-with-real-key
PURCHASE_NOTIFICATION_EMAIL=notifications@example.org
NOTIFICATION_FROM_EMAIL=EcoQuest <onboarding@resend.dev>
# Required in production so password-reset links use a trusted HTTPS origin.
PUBLIC_APP_URL=https://app.example.org
# Set separately when the public API/webhook origin differs from the frontend.
PUBLIC_API_URL=https://api.example.org

# ── Twilio (SMS notifications) ───────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-real-token
TWILIO_FROM_NUMBER=+15555550123

# ── Google Sheets (admin sync) ───────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=1xqrjBMynOYuqGbvmBbuEHXFWZT0ZpwQE6Uy2N7tkr-Q
GOOGLE_SERVICE_ACCOUNT={"type":"service_account",...}
# Client-safe override (optional):
VITE_SPREADSHEET_ID=1xqrjBMynOYuqGbvmBbuEHXFWZT0ZpwQE6Uy2N7tkr-Q

# ── Microservices URLs (optional, used by Vite client) ───────────────────────
VITE_FL_URL=http://localhost:8080
VITE_SNN_URL=http://localhost:8002
VITE_CAUSAL_URL=http://localhost:8001

# ── Dataset release (optional) ───────────────────────────────────────────────
HF_TOKEN=hf_replace-with-real-token
OSF_TOKEN=replace-with-real-token
OSF_PROJECT_ID=replace-with-real-project-id

# ── Vite dev proxy ───────────────────────────────────────────────────────────
# When `npm run dev` runs on one machine and the API server on another
# (e.g. testing on a phone over LAN), point this at the API host.
VITE_API_PROXY=http://localhost:3000

# ── Misc toggles ─────────────────────────────────────────────────────────────
DISABLE_HMR=false
LEGACY_SERVER=0      # set to "1" to fall back to the pre-bootstrap entry

# ── Security ────────────────────────────────────────────────────────────────
# Required in production for signing and verifying model manifests.
# Generate with: openssl rand -hex 32
BMO_MODEL_HMAC_SECRET=replace-with-random-32-bytes-hex
# Trust proxy level for correct IP detection (rate limiting, audit logs)
# 1 = trust first proxy (nginx, single load balancer)
# 2 = trust second proxy, etc.
TRUST_PROXY=1

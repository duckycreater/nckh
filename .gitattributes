# Force LF line endings for text files so Windows checkouts don't commit CRLF
# and create noisy diffs. Pair with the .editorconfig / scripts/check-duplicate-paths.mjs
# pre-commit guard. Binary files are detected automatically.
* text=auto eol=lf

# Shell scripts must stay executable
*.sh text eol=lf

# TypeScript/JavaScript: LF, no BOM
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Docs
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows-only project files
*.ps1 text eol=crlf
*.bat text eol=crlf